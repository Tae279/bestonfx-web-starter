{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "preset": "bestonfx-fizens-light",
  "source": "fizens.framer.ai",
  "derived": "2026-05-27",
  "description": "Light-theme royal-blue fintech system derived from the Fizens Framer template. Replaces the prior dark-navy + champagne-gold direction.",
  "color": {
    "brand": {
      "50": { "value": "#f5faff", "type": "color", "$description": "Lightest surface tint" },
      "100": { "value": "#eff4ff", "type": "color", "$description": "Section / chip background" },
      "200": { "value": "#d1e0ff", "type": "color", "$description": "Soft borders, badge bg" },
      "300": { "value": "#a9c5ff", "type": "color" },
      "400": { "value": "#6098ff", "type": "color" },
      "500": { "value": "#2970ff", "type": "color", "$description": "Bright/hover blue" },
      "600": { "value": "#1257e6", "type": "color" },
      "700": { "value": "#0040c1", "type": "color", "$description": "PRIMARY — the single chromatic anchor" },
      "800": { "value": "#0a3196", "type": "color" },
      "900": { "value": "#0b2a73", "type": "color", "$description": "Dark blue sections / deep text" },
      "950": { "value": "#071b4d", "type": "color" }
    },
    "ink": {
      "50": { "value": "#fafafa", "type": "color" },
      "100": { "value": "#f3f4f6", "type": "color", "$description": "Muted surface" },
      "200": { "value": "#e5e7eb", "type": "color", "$description": "Default border" },
      "300": { "value": "#d1d5db", "type": "color" },
      "400": { "value": "#9ca3af", "type": "color" },
      "500": { "value": "#6b7280", "type": "color", "$description": "Muted text" },
      "600": { "value": "#4b5563", "type": "color", "$description": "Body text" },
      "700": { "value": "#374151", "type": "color" },
      "800": { "value": "#1f2937", "type": "color" },
      "900": { "value": "#171717", "type": "color", "$description": "Primary text / headings" },
      "950": { "value": "#0a0a0a", "type": "color" }
    },
    "semantic": {
      "background": { "value": "#ffffff", "type": "color" },
      "foreground": { "value": "#171717", "type": "color" },
      "muted": { "value": "#f3f4f6", "type": "color" },
      "muted-foreground": { "value": "#6b7280", "type": "color" },
      "border": { "value": "#e5e7eb", "type": "color" },
      "primary": { "value": "#0040c1", "type": "color" },
      "primary-foreground": { "value": "#ffffff", "type": "color" },
      "ring": { "value": "#0040c1", "type": "color" }
    },
    "accent": {
      "line": { "value": "#06C755", "type": "color", "$description": "LINE green — conversion path only" },
      "risk": { "value": "#b45309", "type": "color", "$description": "Amber-700 — compliance/risk emphasis" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": ["Prompt", "system-ui", "sans-serif"], "$description": "Prompt = Thai+Latin geometric, the Poppins equivalent that supports Thai" }
    },
    "display": { "fontFamily": "Prompt", "fontWeight": 600, "fontSize": "clamp(2.5rem, 6vw, 4rem)", "lineHeight": "1.05", "letterSpacing": "-0.03em" },
    "h2": { "fontFamily": "Prompt", "fontWeight": 600, "fontSize": "clamp(2rem, 4vw, 3rem)", "lineHeight": "1.1", "letterSpacing": "-0.02em" },
    "h3": { "fontFamily": "Prompt", "fontWeight": 600, "fontSize": "clamp(1.5rem, 3vw, 2.25rem)", "lineHeight": "1.2", "letterSpacing": "-0.02em" },
    "body": { "fontFamily": "Prompt", "fontWeight": 400, "fontSize": "1.125rem", "lineHeight": "1.6", "letterSpacing": "0" },
    "eyebrow": { "fontWeight": 500, "fontSize": "0.875rem", "letterSpacing": "0.28em", "textTransform": "uppercase" }
  },
  "radius": {
    "sm": { "value": "0.375rem", "type": "dimension" },
    "md": { "value": "0.75rem", "type": "dimension" },
    "lg": { "value": "1rem", "type": "dimension" },
    "xl": { "value": "1.5rem", "type": "dimension" },
    "2xl": { "value": "2rem", "type": "dimension" },
    "full": { "value": "9999px", "type": "dimension", "$description": "Pills — primary CTA + chips" }
  },
  "shadow": {
    "glow": { "value": "0 15px 44px rgba(0, 64, 193, 0.25)", "type": "shadow", "$description": "Signature soft blue glow" },
    "glow-sm": { "value": "0 10px 30px rgba(0, 64, 193, 0.16)", "type": "shadow" },
    "soft": { "value": "0 1px 2px rgba(16, 24, 40, 0.04), 0 8px 24px -8px rgba(16, 24, 40, 0.10)", "type": "shadow" },
    "card": { "value": "0 1px 3px rgba(16, 24, 40, 0.06), 0 12px 28px -12px rgba(16, 24, 40, 0.12)", "type": "shadow" }
  },
  "gradient": {
    "brand": { "value": "linear-gradient(124deg, #0040c1 0%, #2739c7 50%, #495ad9 100%)", "type": "gradient" },
    "brand-bright": { "value": "linear-gradient(115deg, #2970ff 50%, #6098ff 100%)", "type": "gradient" }
  },
  "_rejected": [
    "champagne gold accents (#D4AF37)",
    "dark navy base (#050b18)",
    "graphite surfaces",
    "dark glassmorphism cards",
    "playful pink accent (kept Fizens light/blue but dropped its consumer-friendly pink for broker sobriety)"
  ]
}
